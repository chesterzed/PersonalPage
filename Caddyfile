domain.ru, www.domain.ru {
        log {
                output stderr
        }

        # Unity WebGL Brotli support
        @brotli {
                path *.br
        }
        header @brotli Content-Encoding br

        @jsBrotli {
                path *.js.br
        }
        header @jsBrotli Content-Type application/javascript

        @wasmBrotli {
                path *.wasm.br
        }
        header @wasmBrotli Content-Type application/wasm

        @dataBrotli {
                path *.data.br
        }
        header @dataBrotli Content-Type application/octet-stream

        header {
                X-Frame-Options "SAMEORIGIN"
                X-Content-Type-Options "nosniff"
                Referrer-Policy "strict-origin-when-cross-origin"
        }

        handle_path /static/* {
                # CHANGE THIS to the absolute path of your static files on the server
                root * /path/to/static
                file_server
        }

        handle_path /media/* {
                # CHANGE THIS to the absolute path of your media files on the server
                root * /path/to/media
                file_server
        }

        handle {
                reverse_proxy 127.0.0.1:8002
        }

        encode gzip zstd
}
